# Z-CMS — Caddy reverse proxy with automatic HTTPS.
# DOMAIN and ACME_EMAIL are injected from the environment by compose/caddy.yml.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# The core API. Routes are under /api/v1.
	@api path /api /api/*
	handle @api {
		reverse_proxy cms-api:4100
	}

	# The admin UI, mounted under /admin (ADMIN_BASE_PATH).
	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy admin-web:3001
	}

	# Public media. Path is preserved (path-style S3: /zcms-media/<key>), so the
	# object URL S3_PUBLIC_URL=https://DOMAIN/zcms-media resolves straight through.
	@media path /zcms-media/*
	handle @media {
		reverse_proxy rustfs:9000
	}

	# Everything else is the public site (any path, all tenant content).
	handle {
		reverse_proxy site-runtime:3000
	}
}
