# Z-CMS — Nginx reverse proxy.
# ${DOMAIN} is substituted at container start by the nginx image (envsubst).
# nginx's own runtime variables ($host, $remote_addr, …) are left untouched.

# Uploads (media, package sideloads) can be large — raise the body limit.
client_max_body_size 64m;

# Shared proxy headers for every upstream.
proxy_http_version 1.1;
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header Upgrade           $http_upgrade;
proxy_set_header Connection        "upgrade";

# ---------------------------------------------------------------------------
# HTTP :80 — works immediately. If you terminate TLS here (see the HTTPS block
# below), replace the routing here with a redirect to https.
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Core API (routes are /api/v1).
    location /api/ {
        proxy_pass http://cms-api:4100;
    }

    # Admin UI, mounted under /admin (ADMIN_BASE_PATH).
    location /admin {
        proxy_pass http://admin-web:3001;
    }

    # Public media. Path preserved (path-style S3: /zcms-media/<key>).
    location /zcms-media/ {
        proxy_pass http://rustfs:9000;
    }

    # Everything else is the public site.
    location / {
        proxy_pass http://site-runtime:3000;
    }
}

# ---------------------------------------------------------------------------
