##############################################################################
#  Z-CMS — environment configuration
#
#  1.  cp .env.example .env
#  2.  Fill the secrets:  ./scripts/generate-secrets.sh --write
#      (or run it without --write and paste its output over the SECRETS block).
#  3.  Set DOMAIN + PUBLIC_SCHEME + the *_URL / S3_PUBLIC_URL values for your host.
#
#  Everything a container reads is defined here. The compose files inject these
#  values; the security-sensitive front ends (site-runtime, plugin-runtime) are
#  handed ONLY the few keys they need — never the whole file — because they run
#  third-party theme/plugin code. See docs/architecture.md for why.
##############################################################################


# =============================================================================
#  PUBLIC ADDRESS  — where browsers reach this instance
# =============================================================================
# The public hostname of the site (no scheme, no trailing slash).
# For a purely local test, leave it as localhost.
DOMAIN=localhost

# https once you have TLS (Traefik/Caddy/Nginx/Apache examples all set it up).
# http only for a bare localhost quickstart.
PUBLIC_SCHEME=http

# Primary public host of the main site, used by the deploy-time locale step.
# Usually the same as DOMAIN (add :PORT for a local non-80 test, e.g. localhost:3000).
ROOT_DOMAIN=localhost

# The pinned image version. `latest` tracks the newest release; pin an exact
# tag (e.g. 0.1.0) for reproducible production deploys.
ZCMS_VERSION=latest

# Email for Let's Encrypt / ACME registration. Required by the Traefik and Caddy
# reverse-proxy examples (they obtain TLS certificates automatically). Ignored by
# the bare quickstart and by the Nginx/Apache examples (you supply certs there).
ACME_EMAIL=you@example.com


# =============================================================================
#  SECRETS  — REGENERATE EVERY ONE before exposing this to the internet.
#  Generate all of them at once:   ./scripts/generate-secrets.sh
# =============================================================================

# --- Database (owner role) --------------------------------------------------
# The owner role bypasses Row-Level Security; guard this password.
POSTGRES_USER=zcms
POSTGRES_PASSWORD=change-me-postgres-owner
POSTGRES_DB=zcms

# --- Database (runtime role, subject to RLS) --------------------------------
# These MUST match compose/postgres/init/01-app-role.sql, which creates the role
# on first boot. The app role is only reachable inside the Docker network
# (Postgres is never published), so this is a network-internal credential.
# If you change them, change the SQL file to match BEFORE first boot.
APP_DB_USER=zcms_app
APP_DB_PASSWORD=zcms_app

# --- Auth -------------------------------------------------------------------
JWT_SECRET=change-me-jwt-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Service-to-service tokens ----------------------------------------------
# PRIVILEGED token: worker + plugin-runtime use it for side-effecting internal
# endpoints. Keep it out of any process running untrusted code.
CMS_INTERNAL_TOKEN=change-me-internal-token
# RENDER-channel token for cms-api <-> site-runtime ONLY. site-runtime runs
# third-party theme code, so it gets THIS, not the privileged one. MUST be a
# value distinct from CMS_INTERNAL_TOKEN — the stack refuses to start otherwise.
SITE_RUNTIME_INTERNAL_TOKEN=change-me-render-token

# --- Encryption keys (32 random bytes, base64 or hex) -----------------------
# Set ONCE and keep forever. Rotating TOTP_ENCRYPTION_KEY makes every enrolled
# authenticator undecryptable (every 2FA user must re-enroll). Back these up
# wherever you back up JWT_SECRET.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=change-me-32-byte-base64-key
MAIL_ENCRYPTION_KEY=change-me-32-byte-base64-key

# --- Cache / queue ----------------------------------------------------------
# Redis is password-protected; site-runtime is NOT given this password so a
# hostile theme cannot read or poison the render cache.
REDIS_PASSWORD=change-me-redis-password

# --- Object storage (bundled RustFS, S3-compatible) -------------------------
S3_ACCESS_KEY=change-me-s3-access-key
S3_SECRET_KEY=change-me-s3-secret-key

# --- First admin user, created by the seed ----------------------------------
# With a real domain the seed REFUSES to run with an empty or well-known
# password (admin123, password, …). Set a strong one here.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password


# =============================================================================
#  STORAGE URLs  — derived from DOMAIN; adjust only for a custom media host
# =============================================================================
S3_REGION=us-east-1
S3_BUCKET=zcms-media
# Where a BROWSER fetches uploaded media from. The reverse-proxy examples route
# ${DOMAIN}/zcms-media -> the storage service, so this is the default. Point it
# at a CDN / R2 custom domain if you serve media elsewhere.
S3_PUBLIC_URL=http://localhost:9000/zcms-media
#   Behind a proxy (Traefik/Nginx/Apache/Caddy examples) use instead:
#   S3_PUBLIC_URL=https://your-domain.com/zcms-media


# =============================================================================
#  ADMIN + SITE
# =============================================================================
# The admin lives UNDER each public site's origin at this path, e.g.
# https://your-domain.com/admin. The reverse-proxy examples route it there.
ADMIN_BASE_PATH=/admin

# Public origins, used for links, CORS and CSP. Set to your real https origin.
CMS_API_URL=http://localhost:4100
ADMIN_WEB_URL=http://localhost:3001
SITE_RUNTIME_URL=http://localhost:3000

# Optional. Only set if a BROWSER calls the API cross-origin directly; normally
# the front ends proxy the API same-origin, so leave this blank.
CMS_API_PUBLIC_URL=

# Host ports for the bare quickstart (docker-compose.yml). Published on
# 127.0.0.1 only. The reverse-proxy examples ignore these and route internally.
CMS_API_PORT=4100
ADMIN_WEB_PORT=3001
SITE_RUNTIME_PORT=3000


# =============================================================================
#  MAIL  (optional)
#  A bundled Mailpit captures all outgoing mail at http://localhost:8025 by
#  default so invites/password-resets work with no real mail server. For real
#  delivery, prefer the admin's Settings -> Mail (encrypted at rest, per-site),
#  or point these at your SMTP provider.
# =============================================================================
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=Z-CMS <no-reply@example.com>
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_PLUGIN_HOURLY_LIMIT=200


# =============================================================================
#  TRUST ANCHORS  (signature verification — do not invent values)
# =============================================================================
# The public key the OFFICIAL images are signed with. The built-in themes and
# plugins baked into the published images are verified against this before a
# byte of them runs. The value below matches the official Docker Hub images —
# leave it as-is unless you build and sign your own images.
FIRST_PARTY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAKlZg1nED9EybjxuY9Oah8ppD/3n09jOngODUVzeXFJw=\n-----END PUBLIC KEY-----"

# The marketplace this instance trusts (installs from + enforces revocations).
# Defaults to the official Z-CMS marketplace, so the admin lists its themes and
# plugins out of the box. The key — not the hostname — is the trust boundary:
# every package and the revocation list is verified against it, so a hostile host
# yields packages that fail verification, not packages that run.
#   - Run fully OFFLINE: blank BOTH (built-in themes/plugins still work).
#   - Use a PRIVATE marketplace: point the URL at it and pin its public key here.
MARKETPLACE_URL=https://marketplace.z-cms.org
MARKETPLACE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAynHeppMexHtzTv/Tf2DVGEGWcDZ0YFZAEwy47BvwGmQ=\n-----END PUBLIC KEY-----"

# Operator key for sideloading (installing a theme/plugin from a file, no
# marketplace). All optional; blank = sideload endpoints refuse every upload.
# Generate a pair with `zcms keygen` and put the PUBLIC half here.
OPERATOR_PUBLIC_KEY=
# Set ONLY to enable the .zip convenience path (cms-api signs uploads for you).
# Trade-off: an attacker who owns cms-api can then sign code site-runtime runs.
# Prefer signing offline (`zcms pack --operator-key private.pem`) and leave blank.
OPERATOR_PRIVATE_KEY=
# A theme runs UNSANDBOXED in site-runtime, so sideloading one is code execution
# in the render process. Off until you set it to true on purpose.
ALLOW_THEME_SIDELOAD=false


# =============================================================================
#  TUNING / OPS  (sensible defaults; change only if you know why)
# =============================================================================
DB_POOL_MAX=10
WORKER_CONCURRENCY=4
MFA_ISSUER=Z-CMS
# Behind a proxy this must be the real hop count (usually 1), never "true".
TRUST_PROXY=1
# Serve the OpenAPI docs at /api/v1/docs. Safe to leave on.
SWAGGER_ENABLED=true
# Any endpoint that accepts a JSON POST; four security events are pushed here.
# Empty = log only.
SECURITY_ALERT_WEBHOOK=

# Deploy-time locale enablement for the main multilingual site. Leave 0 for
# generic multi-site deployments.
ENABLE_SITE_LOCALES_ON_DEPLOY=0
SITE_LOCALES=en,vi,ja
